{
  // Desk bridge for one Jarvis robot. No account id, no secrets, no routes
  // that name a real hostname. Copy nothing secret into this file.
  "name": "jarvis-desk-bridge",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-10",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "durable_objects": {
    "bindings": [
      { "name": "DEVICE_HUB", "class_name": "DeviceHub" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DeviceHub"] }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "vars": {
    "MAX_SESSION_MINUTES_PER_DAY": "60",
    "MAX_TOKENS_PER_HOUR": "6",
    "TOKEN_TTL_SECONDS": "600",
    "COMMAND_TIMEOUT_SECONDS": "300",
    "MAX_COMMAND_CHARS": "2000",
    "DUPLICATE_WINDOW_SECONDS": "30",
    "XAI_VOICE": "leo",
    "XAI_MODEL": "grok-voice-3.0"
  }
}
