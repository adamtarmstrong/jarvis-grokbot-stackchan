# Jarvis firmware for M5Stack CoreS3 / StackChan K151.
# No Wi-Fi names, tokens, or keys. Those live in NVS after setup.
CONFIG_IDF_TARGET="esp32s3"

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# CoreS3 in-package PSRAM is quad, not octal.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Leave DMA for the microphone. See firmware/docs/known_issues.md.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=4

# esp-sr ~2.6 WakeNet preset "Jarvis" (wn9_jarvis_tts). Confirm the Kconfig
# symbol still exists when the component manager resolves 2.6.x.
CONFIG_MODEL_IN_FLASH=y
CONFIG_SR_WN_WN9_JARVIS_TTS=y
CONFIG_SR_MN_CN_NONE=y
CONFIG_SR_MN_EN_NONE=y

# Camera stays compiled out. Wake word and the GC0308 do not fit together
# on CoreS3 internal DMA (groki-bot known issue, ported in docs).

# HTTPS to the Worker and to api.x.ai uses the Espressif certificate bundle.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# wifi_prov_scheme_ble is compiled only when a BT host is enabled.
# NimBLE is the smaller host. Classic BR/EDR is not a CoreS3 controller mode.
CONFIG_BT_ENABLED=y
# CONFIG_BT_BLUEDROID_ENABLED is not set
CONFIG_BT_NIMBLE_ENABLED=y
